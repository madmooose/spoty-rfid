# Copy to /etc/spoty-rfid/spoty-rfid.env and chmod 600. Never commit the real file.
#
# NOTE: With the setup portal, these secrets are now OPTIONAL here — a blank box
# can be configured entirely through the portal (written to SQLite). But if you
# provision declaratively, set them here: env vars take priority over anything
# the portal saved.

# Telegram: create a bot via @BotFather, paste the token here.
# Leave commented to configure via the portal instead (saved to SQLite).
# An UNcommented value here ALWAYS wins over the portal — so only set it if
# you provision declaratively. Do NOT leave a dummy value uncommented: it
# shadows the portal-saved token and traps the box in setup mode.
#TELEGRAM_TOKEN=123456:ABC-your-bot-token

# Spotify: developer.spotify.com/dashboard -> create app
#SPOTIFY_CLIENT_ID=xxxxxxxxxxxxxxxx
#SPOTIFY_CLIENT_SECRET=xxxxxxxxxxxxxxxx

# IMPORTANT: must be a loopback literal (NOT http://localhost). Add this exact
# value to your Spotify app's Redirect URIs in the dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Optional: pin playback to a specific device (else uses the active one).
# Find IDs via /status once linked, or the dashboard's player endpoint.
#SPOTIFY_DEVICE_ID=

# Hardware / network
RFID_DEVICE=/dev/hidraw0
WEB_PORT=8080
AP_SSID=SpotyBox
AP_PASSWORD=changeme-min-8-chars
WIFI_IFACE=wlan0

# Seconds to wait for the startup "I'm here" tap before entering setup mode
ACK_TIMEOUT=60
