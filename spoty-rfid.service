[Unit]
Description=SpotyBox - RFID Spotify player controlled via Telegram
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
User=spotybox
# Pull secrets from an env file kept out of git (chmod 600)
EnvironmentFile=/etc/spoty-rfid/spoty-rfid.env
WorkingDirectory=/opt/spoty-rfid
ExecStart=/opt/spoty-rfid/.venv/bin/python -m spotyrfid.main
Restart=on-failure
RestartSec=5
# Box needs to manage Wi-Fi via nmcli and read the hidraw device
SupplementaryGroups=netdev plugdev

[Install]
WantedBy=multi-user.target
